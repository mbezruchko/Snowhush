# snowhush-bin on the AUR: the app as GitHub Actions built it for the release. update.sh sets the version and
# the checksum after each release.
pkgname=snowhush-bin
pkgver=0.8.5
pkgrel=1
pkgdesc="Snow on your Wayland desktop, in KDE Plasma, Hyprland, Sway or niri: it settles on windows and parts around the cursor"
arch=('x86_64')
url="https://snowhush.pages.dev"
license=('PolyForm-Noncommercial-1.0.0')
depends=('libglvnd' 'wayland' 'gcc-libs' 'glibc')
provides=('snowhush')
conflicts=('snowhush')
source=("snowhush-linux-x86_64-$pkgver.tar.gz::https://github.com/mbezruchko/Snowhush/releases/download/v$pkgver/snowhush-linux-x86_64.tar.gz")
sha256sums=('53d4ac50e8b5d78d2c67860a15d2f5d1e7d6e54d2bd047aaafbbea1242df3304')

package() {
    cp -a "$srcdir/usr" "$pkgdir/"
}
