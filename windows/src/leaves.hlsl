/// How far a digitized blade reaches from its middle at `angle` from its tip.
static float leafReach(int kind, float angle) {
    float f = frac(angle / 6.2831853) * float(LEAF_SAMPLES);
    int i = int(floor(f));
    int j = i + 1 == LEAF_SAMPLES ? 0 : i + 1;
    return lerp(LEAF_REACH[kind * LEAF_SAMPLES + i], LEAF_REACH[kind * LEAF_SAMPLES + j], f - floor(f));
}

/// Which of the digitized leaves a seed draws, each as often as `LEAF_ODDS` says.
static int leafKind(float seed) {
    float f = frac(seed * 13.7);
    for (int k = 0; k < LEAF_KINDS - 1; k++) {
        if (f < LEAF_ODDS[k]) return k;
    }
    return LEAF_KINDS - 1;
}

